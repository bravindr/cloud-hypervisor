# dsa-integration benchmark configuration: iaa-integration daemon (base) vs
# dsa-integration daemon with CPU and DSA classification, on their harness.
BUILD_BINARIES=0
AUTO_SETUP=0
DOWNLOAD_ASSETS=0
WITH_QPL=1
CLEAN_RESULTS=1
CLEANUP_TAP=1
CLEANUP_EXISTING_VMS=1
TAP_NAME=tap0
TAP_HOST_CIDR=192.168.2.1/25
GUEST_MAC=12:34:56:78:90:ab
GUEST_IP=192.168.2.2
GUEST_PREFIX=25
GUEST_GATEWAY=192.168.2.1

BIN_DIR=$HOME/cloud-hypervisor/target-iaa/release
BASE_OFFLOAD_BIN=$HOME/ch-iaa-base/target/release/offload_daemon
DTO_WQ_LIST="wq0.0;wq2.0;wq4.0;wq6.0"
DTO_IS_NUMA_AWARE=1
DTO_LOG_LEVEL=1

SOURCE_API_SOCKET=/tmp/ch-compression-source.sock
RESTORE_API_SOCKET=/tmp/ch-compression-restore.sock
OFFLOAD_SOCKET=/tmp/ch-compression-offload.sock
RESTORE_SOCKET=/tmp/ch-compression-restore-data.sock

CODECS="raw lz4 zstd qpl-hardware-static-async qpl-hardware-dynamic-async"
CLASSIFY_MODES="base cpu dsa dsacrc"
CHUNK_SIZES="1048576"
SOFTWARE_WORKER_COUNTS="1"
QPL_ASYNC_SNAPSHOT_DEPTHS="8 32"
QPL_ASYNC_RESTORE_DEPTHS="32"
DSA_DEPTH=32
RESTORE_HUGETLB=0
ITERATIONS=3
WARMUPS=1
ZSTD_LEVEL=1
KEEP_ALL_SNAPSHOTS=0
RESTORE_SNAPSHOT_ITERATION=1
COLD_CACHE=0
RESUME_VM=1
AUTO_CPU_AFFINITY=1
CPU_AFFINITY_SOCKET=0
PREFER_PHYSICAL_CORES=1

KERNEL_PATH=$HOME/cloud-hypervisor/benchmark/assets/vmlinux-x86_64
DISK_PATH=$HOME/cloud-hypervisor/benchmark/assets/jammy-server-cloudimg-amd64-custom-20241017-0.qcow2
MEMORY_SIZE=4G
VCPUS=4
COPY_DISK=1
CREATE_CLOUD_INIT=1
KERNEL_CMDLINE="root=/dev/vda1 console=hvc0 rw"
GUEST_SSH_TARGET=cloud@192.168.2.2
SSH_PASSWORD=cloud123
WORKING_SET_MIB=1536
MEMORY_PATTERN=silesia
SILESIA_PATH=$HOME/cloud-hypervisor/benchmark/assets/silesia.tar
REDIS_AUTO_INSTALL=0
PAUSE_AFTER_PREPARE=1
