# Adjust these settings for the host and benchmark workload.

# Top-level benchmark.sh orchestration.
BUILD_BINARIES=1
AUTO_SETUP=1
DOWNLOAD_ASSETS=1
WITH_QPL=1
CLEAN_RESULTS=1
CLEANUP_TAP=1
CLEANUP_EXISTING_VMS=1
TAP_NAME=tap0
TAP_HOST_CIDR=192.168.2.1/25
GUEST_MAC=12:34:56:78:90:ab
GUEST_IP=192.168.2.2
GUEST_PREFIX=25
GUEST_GATEWAY=192.168.2.1

SOURCE_API_SOCKET=/tmp/ch-compression-source.sock
RESTORE_API_SOCKET=/tmp/ch-compression-restore.sock
OFFLOAD_SOCKET=/tmp/ch-compression-offload.sock
RESTORE_SOCKET=/tmp/ch-compression-restore-data.sock

CODECS="raw lz4 zstd qpl-hardware-static-async qpl-hardware-dynamic-async"
CHUNK_SIZES="1048576"
SOFTWARE_WORKER_COUNTS="1"
QPL_ASYNC_SNAPSHOT_DEPTHS="8"
QPL_ASYNC_RESTORE_DEPTHS="32"
ITERATIONS=3
WARMUPS=1
ZSTD_LEVEL=1
# Keep only RESTORE_SNAPSHOT_ITERATION for each configuration by default.
KEEP_ALL_SNAPSHOTS=0
RESTORE_SNAPSHOT_ITERATION=1

# Set to 1 only when running restore benchmarks as root.
COLD_CACHE=0
# Set to 0 to measure restore-to-paused instead of restore-and-resume.
RESUME_VM=1
# Pin the VM to the first VCPUS logical CPUs on the selected socket and reserve
# one additional CPU per software worker. Set to 0 to leave both unbound.
AUTO_CPU_AFFINITY=1
CPU_AFFINITY_SOCKET=0
PREFER_PHYSICAL_CORES=1
# VM_CPU_LIST=0-3
# OFFLOAD_CPU=4-7
# VM_COUNT=2

# Defaults use assets downloaded by benchmark/download-assets.sh.
# KERNEL_PATH=$HOME/workloads/vmlinux
# DISK_PATH=$HOME/workloads/jammy-server-cloudimg-amd64.raw
MEMORY_SIZE=4G
VCPUS=4
COPY_DISK=1
CREATE_CLOUD_INIT=1
KERNEL_CMDLINE="root=/dev/vda1 console=hvc0 rw"

# Guest preparation over SSH. Configure networking when starting the VM.
# Canonical image defaults: cloud@192.168.2.2 with password cloud123.
GUEST_SSH_TARGET=cloud@192.168.2.2
# SSH_KEY=$HOME/.ssh/id_ed25519
SSH_PASSWORD=cloud123
WORKING_SET_MIB=1536
# Set this above WORKING_SET_MIB when the guest's default /dev/shm is too small.
# SHM_SIZE_MIB=2560
MEMORY_PATTERN=silesia
# SILESIA_PATH=$PWD/benchmark/assets/silesia.tar
REDIS_VALUE_SIZE=4096
# REDIS_SERVER_PATH=/usr/bin/redis-server
# REDIS_CLI_PATH=/usr/bin/redis-cli
# Set to 0 when Redis is preinstalled or the guest has no package-network access.
REDIS_AUTO_INSTALL=1
PAUSE_AFTER_PREPARE=1
